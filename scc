:root {
    --primary-bg-color: #fff;
    --primary-text-color: #333;
    --accent-color: #4caf50;
    --border-radius: 10px;
    --shadow-color: rgba(0, 0, 0, 0.1);
}

body {
    font-family: 'Inter', sans-serif;
    margin: 0;
    padding: 0;
    background-color: var(--primary-bg-color);
    color: var(--primary-text-color);
}

header {
    background: var(--accent-color);
    padding: 20px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 10;
}

header h1 {
    margin: 0;
    font-size: 2.5rem;
}

header h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 300;
}

button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
}

.hero {
    padding: 20px;
}

.hero-card {
    background: #f9f9f9;
    padding: 20px;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 8px var(--shadow-color);
    text-align: center;
}

.grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

@media (min-width: 768px) {
    .grid-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .grid-container {
        grid-template-columns: repeat(3, 1fr);
    }
}

.hidden {
    display: none;
}

footer {
    text-align: center;
    padding: 15px;
    background: var(--accent-color);
    color: white;
    position: relative;
    bottom: 0;
    width: 100%;
}
